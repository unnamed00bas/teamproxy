# ----------------------------------------------------------------------------
# Control Plane environment. Copy to .env and adjust. NEVER commit the real .env.
# Production secrets should come from GitHub Secrets / server env, not this file.
# ----------------------------------------------------------------------------

# --- General ---
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=Control Plane

# --- Security ---
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-please-generate-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=720

# First superadmin, created on first startup if no users exist.
FIRST_SUPERADMIN_EMAIL=admin@example.com
FIRST_SUPERADMIN_PASSWORD=changeme123

# --- Database (Postgres) ---
POSTGRES_USER=control
POSTGRES_PASSWORD=control
POSTGRES_DB=control_plane
# Used by the backend (asyncpg). Compose injects this automatically.
DATABASE_URL=postgresql+asyncpg://control:control@db:5432/control_plane

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
# Public base URL the browser uses to reach the backend API. Leave empty to use
# same-origin requests (/api), which is correct when the UI and API are served
# on one host behind Traefik. Set it only to point the browser at a different
# origin (e.g. https://api.example.com). Applied at image build time.
PUBLIC_API_BASE_URL=

# --- WireGuard hub ---
# The VPS hub all site gateways connect to. Used to auto-fill generated
# gateway configs. The public key and endpoint are not secrets; only the hub's
# private key (kept on the VPS) is. Leave blank to render placeholders instead.
WG_HUB_PUBLIC_KEY=
WG_HUB_ENDPOINT=vps.example.com:51820
WG_HUB_TUNNEL_SUBNET=10.10.0.0/24

# --- Traefik / TLS ---
ACME_EMAIL=admin@example.com
# Public hostname the admin panel (UI + API) is served on. REQUIRED in
# production: Traefik uses it as the Host() matcher and the domain it requests a
# Let's Encrypt certificate for. Without it Traefik falls back to a self-signed
# cert and browsers reject the connection. e.g. admin.mishteam.site
ADMIN_DOMAIN=
TRAEFIK_DYNAMIC_DIR=/data/traefik/dynamic
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_WEB_ENTRYPOINT=web
TRAEFIK_WEBSECURE_ENTRYPOINT=websecure
