# ----------------------------------------------------------------------------
# Control Plane environment. Copy to .env and adjust. NEVER commit the real .env.
# Production secrets should come from GitHub Secrets / server env, not this file.
# ----------------------------------------------------------------------------

# --- General ---
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=Control Plane

# --- Security ---
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-please-generate-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=720

# First superadmin, created on first startup if no users exist.
FIRST_SUPERADMIN_EMAIL=admin@example.com
FIRST_SUPERADMIN_PASSWORD=changeme123

# --- Database (Postgres) ---
POSTGRES_USER=control
POSTGRES_PASSWORD=control
POSTGRES_DB=control_plane
# Used by the backend (asyncpg). Compose injects this automatically.
DATABASE_URL=postgresql+asyncpg://control:control@db:5432/control_plane

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
# Public base URL the browser uses to reach the backend API.
PUBLIC_API_BASE_URL=http://localhost:8000

# --- Traefik / TLS ---
ACME_EMAIL=admin@example.com
TRAEFIK_DYNAMIC_DIR=/data/traefik/dynamic
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_WEB_ENTRYPOINT=web
TRAEFIK_WEBSECURE_ENTRYPOINT=websecure
# Docker API version Traefik's provider talks to the daemon with. Raise this if
# your daemon enforces a higher minimum than 1.40.
DOCKER_API_VERSION=1.40
