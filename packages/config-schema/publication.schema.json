{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-plane.local/schemas/publication.schema.json",
  "title": "Publication",
  "description": "A routing rule mapping a domain/entrypoint to an internal service. This is the canonical contract the config renderer consumes.",
  "type": "object",
  "required": ["service_id", "entrypoint_type"],
  "properties": {
    "service_id": { "type": "string" },
    "entrypoint_type": { "enum": ["web", "tcp", "udp"] },
    "domain_or_sni": { "type": ["string", "null"] },
    "path_prefix": { "type": ["string", "null"] },
    "tls_enabled": { "type": "boolean", "default": true },
    "tls_mode": { "enum": ["off", "letsencrypt", "passthrough", "custom"] },
    "published_port": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
    "public_enabled": { "type": "boolean", "default": true },
    "maintenance_mode": { "type": "boolean", "default": false },
    "priority": { "type": "integer", "default": 0 },
    "middleware_profile": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "entrypoint_type": { "const": "web" } } },
      "then": { "required": ["domain_or_sni"] }
    },
    {
      "if": { "properties": { "entrypoint_type": { "const": "tcp" } } },
      "then": { "required": ["published_port"] }
    }
  ]
}
