# Self-hosted GitHub Actions runner as a systemd service.
# Install location example: /etc/systemd/system/github-runner.service
# Run the runner as a dedicated unprivileged user (NOT root). That user must be
# a member of the `docker` group to drive docker compose.
#
#   sudo useradd -m -s /bin/bash gh-runner
#   sudo usermod -aG docker gh-runner
#   # then follow GitHub's "Add self-hosted runner" steps as gh-runner
#   sudo ./svc.sh install gh-runner   # generates a unit similar to this one
#
# This file documents the recommended hardening if you manage the unit by hand.

[Unit]
Description=GitHub Actions self-hosted runner
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=gh-runner
WorkingDirectory=/opt/actions-runner
ExecStart=/opt/actions-runner/run.sh
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
